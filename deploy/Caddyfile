{
	admin off
	auto_https off
}

:8787 {
	bind 127.0.0.1
	encode gzip

	request_body {
		max_size 6MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/docs* {
		respond "Not found" 404
	}
	handle /api/redoc* {
		respond "Not found" 404
	}
	handle /api/openapi.json {
		respond "Not found" 404
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:8000 {
			header_up Host {upstream_hostport}
			header_down Location ^https?://127[.]0[.]0[.]1:8000 /api
			transport http {
				read_timeout 30s
				write_timeout 30s
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server {
			hide .*
		}
	}
}
