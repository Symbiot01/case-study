# Localhost only. Copy to .env and .env.dev. Do not use these values on a public host.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ecommerce
KEYCLOAK_CLIENT_ID=ecommerce-api
CORS_ORIGINS=http://localhost:5173

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-admin-password-1

MINIO_ROOT_USER=meridian
MINIO_ROOT_PASSWORD=local-minio-root-password-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=product-images
S3_ACCESS_KEY=ecommerce-api
S3_SECRET_KEY=local-minio-api-password-1
S3_ADDRESSING_STYLE=path

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin-local-1
SEED_SHOPPER_USERNAME=shopper
SEED_SHOPPER_PASSWORD=shopper-local-1
SEED_TENANT_USERNAME=ilse
SEED_TENANT_PASSWORD=ilse-local-1
SEED_TENANT_NAME=Studio Ilse
